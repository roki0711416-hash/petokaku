# 公開するサイトのURL。未設定のときは http://localhost:3000 を使います。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 価格の取得元。sample のあいだは外部の通販サイトへ接続しません。
PRICE_SOURCE=sample

# 検索エンジンへの登録。サンプル価格のあいだは true にしても登録されません。
ALLOW_INDEXING=false

# Yahoo!ショッピング商品検索APIのアプリケーションID（Client ID）。
# 本物の値は .env.local にだけ書きます。ここには書かないでください。
# サーバー側だけで使います。NEXT_PUBLIC_ は付けません。
YAHOO_CLIENT_ID=

# 価格履歴DB。Next.js のサーバーだけが使います。ブラウザには渡しません。
# Project URL は、Supabase のプロジェクト画面で Connect を開いたところにあります。
# Secret key は Settings → API Keys の sb_secret_ で始まるキーです。
# anon、publishable key、Legacy の service_role は使いません。NEXT_PUBLIC_ は付けません。
# 本物の値は .env.local にだけ書きます。
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 日次価格更新の入口を呼ぶときの秘密トークン。サーバーだけが使います。
# NEXT_PUBLIC_ は付けません。本物の値は .env.local にだけ書きます。
# 未設定のときは更新を開始しません。
PRICE_REFRESH_SECRET=

# 本番の Vercel Cron が Authorization ヘッダーで送るトークン。サーバーだけが使います。
# NEXT_PUBLIC_ は付けません。本物の値は Vercel の環境変数にだけ置きます。
# このリポジトリでは未設定のままにします。未設定のときは PRICE_REFRESH_SECRET だけを見ます。
CRON_SECRET=
