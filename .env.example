# 公開するサイトのURL。未設定のときは http://localhost:3000 を使います。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 価格の取得元。sample のあいだは外部の通販サイトへ接続しません。
PRICE_SOURCE=sample

# 検索エンジンへの登録。true のとき公開ページのクロールを許可します。価格の取得元とは別です。
ALLOW_INDEXING=false

# Googleアナリティクス4の測定ID。G- で始まる値だけを読み込みます。
# 未設定のときはタグを出しません。本物の値は .env.local と Vercel の環境変数に置きます。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Yahoo!ショッピング商品検索APIのアプリケーションID（Client ID）。
# 本物の値は .env.local にだけ書きます。ここには書かないでください。
# サーバー側だけで使います。NEXT_PUBLIC_ は付けません。
YAHOO_CLIENT_ID=

# Yahoo!ショッピングのバリューコマース提携で作った自由テキストリンクの sid と pid。
# サーバーだけが使います。NEXT_PUBLIC_ は付けません。未設定のときは通常の商品URLを開きます。
# 本物の値は .env.local と Vercel の環境変数に置きます。ここには書かないでください。
YAHOO_AFFILIATE_SID=
YAHOO_AFFILIATE_PID=

# 楽天ウェブサービスのアプリIDとアクセスキー。サーバーだけが使います。
# 未設定のときは楽天市場へ接続しません。NEXT_PUBLIC_ は付けません。
# 楽天アフィリエイトIDを置いたときだけ、楽天の商品リンクを楽天アフィリエイトのURLにします。
# 本物の値は .env.local と Vercel の環境変数に置きます。ここには書かないでください。
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# 接続確認用の入口をサーバーで呼ぶときの秘密トークン。未設定のときは入口を出しません。
# NEXT_PUBLIC_ は付けません。本物の値は Vercel の環境変数にだけ置きます。
RAKUTEN_PROBE_SECRET=

# Amazonは Product Advertising API の利用資格が確認できるまで接続しません。
# 価格・在庫・送料は取りません。確認済みの商品リンクだけを src/data/amazon-links.ts に置きます。

# 価格履歴DB。Next.js のサーバーだけが使います。ブラウザには渡しません。
# Project URL は、Supabase のプロジェクト画面で Connect を開いたところにあります。
# Secret key は Settings → API Keys の sb_secret_ で始まるキーです。
# anon、publishable key、Legacy の service_role は使いません。NEXT_PUBLIC_ は付けません。
# 本物の値は .env.local にだけ書きます。
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 日次価格更新の入口を呼ぶときの秘密トークン。サーバーだけが使います。
# NEXT_PUBLIC_ は付けません。本物の値は .env.local にだけ書きます。
# 未設定のときは更新を開始しません。
PRICE_REFRESH_SECRET=

# 本番の Vercel Cron が Authorization ヘッダーで送るトークン。サーバーだけが使います。
# NEXT_PUBLIC_ は付けません。本物の値は Vercel の環境変数（Production）にだけ置きます。
# Vercel は CRON_SECRET が設定されているときだけ、毎日の GET /api/price-refresh に
# Authorization: Bearer <CRON_SECRET> を付けます。未設定のままだとヘッダーが付かず、
# 入口は 401 になり、見られていない日の価格履歴は増えません。
# 手動で叩くときは PRICE_REFRESH_SECRET か CRON_SECRET と一致する Bearer を送ります。
CRON_SECRET=
